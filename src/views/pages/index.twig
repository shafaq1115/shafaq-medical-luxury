{% extends "layouts.master" %}

{% block content %}

<section class="shafaq-hero">
  <div class="container">
    <div class="shafaq-hero__grid">

      <div class="shafaq-hero__content">
        <span class="shafaq-hero__eyebrow">SHAFAQ MEDICAL LUXURY</span>
        <h1>حلول طبية موثوقة لحياة أكثر راحة واستقلالية</h1>
        <p>
          كراسي كهربائية، وسائل مساعدة على الحركة، رعاية منزلية، علاج طبيعي، وأجهزة طبية منزلية بجودة عالية وخدمة موثوقة داخل المملكة.
        </p>

        <div class="shafaq-hero__actions">
          <a href="/categories" class="shafaq-btn shafaq-btn--primary">تسوق الأقسام</a>
          <a href="/latest-products" class="shafaq-btn shafaq-btn--ghost">أحدث المنتجات</a>
        </div>
      </div>

      <div class="shafaq-hero__visual">
        <div class="shafaq-hero__card">
          <span>منتجات مختارة</span>
          <strong>كراسي كهربائية مناسبة للسفر</strong>
          <small>تصميم خفيف • خيارات متعددة • دعم موثوق</small>
        </div>
      </div>

    </div>
  </div>
<div style="background:green;color:white;padding:30px;font-size:30px;text-align:center">
  TEST CATEGORIES AREA
</div>
</section>
<section class="shafaq-categories">
  <div class="container">
    <div class="section-head">
      <span>الأقسام الرئيسية</span>
      <h2>تسوق حسب احتياجك الطبي</h2>
      <p>أقسام منظمة لتسهيل الوصول إلى منتجات الرعاية والحركة والتجهيزات الطبية.</p>
    </div>

    <div class="shafaq-category-grid shafaq-category-grid--seven">
  <a href="/categories/mobility" class="shafaq-category-card">
    <i class="sicon-wheelchair"></i>
    <h3>وسائل المساعدة على الحركة</h3>
  </a>

  <a href="/categories/home-care" class="shafaq-category-card">
    <i class="sicon-home"></i>
    <h3>الرعاية المنزلية</h3>
  </a>

  <a href="/categories/therapy" class="shafaq-category-card">
    <i class="sicon-heart"></i>
    <h3>العلاج الطبيعي</h3>
  </a>

  <a href="/categories/home-medical-devices" class="shafaq-category-card">
    <i class="sicon-stethoscope"></i>
    <h3>الأجهزة والمستلزمات الطبية المنزلية</h3>
  </a>

  <a href="/categories/back-foot-care" class="shafaq-category-card">
    <i class="sicon-accessibility"></i>
    <h3>العناية بالظهر والقدم</h3>
  </a>

  <a href="/categories/beauty-care" class="shafaq-category-card">
    <i class="sicon-star"></i>
    <h3>العناية والجمال</h3>
  </a>

  <a href="/categories/hospital-equipment" class="shafaq-category-card">
    <i class="sicon-building"></i>
    <h3>تجهيز المستشفيات</h3>
  </a>
</div>

{% component home %}

{% endblock %}

{% block scripts %}
<script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}